{
  "expo": {
    "name": "MediSnap",
    "slug": "MediSnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MediSnapLogo.png",
    "scheme": "medisnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/MediSnapLogo.png",
        "monochromeImage": "./assets/images/MediSnapLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MediSnap"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/MediSnapLogo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/MediSnapLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
