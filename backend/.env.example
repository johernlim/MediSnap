# Append these settings to backend/.env if it already contains chatbot settings.
# Never copy this file over an existing .env containing credentials.
OPENAI_API_KEY=
# Choose a vision + structured-output capable model available to your API project.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
# Choose local weights or Roboflow's hosted model.
YOLO_PROVIDER=local
YOLO_MODEL_PATH=models/yolo26_pills.pt
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu
# Used only when YOLO_PROVIDER=roboflow. Keep this secret on the backend.
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_MODEL_ID=pills-kxe6h-afvos/12
ROBOFLOW_TIMEOUT_SECONDS=60
ROBOFLOW_MAX_SIDE=2048
MAX_DETECTIONS=12
NPRA_DATABASE_PATH=data/npra/medicines.db
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=20000000
MIN_IMAGE_SIDE=64
MIN_CROP_SIDE=48
CROP_PADDING=0.08
CROP_MAX_SIDE=1536
BLUR_THRESHOLD=8
BRIGHTNESS_MIN=15
BRIGHTNESS_MAX=245
MATCH_HIGH_THRESHOLD=90
MATCH_MEDIUM_THRESHOLD=70
MATCH_LOW_THRESHOLD=50
MATCH_MARGIN=15
WEIGHT_IMPRINT=40
WEIGHT_PRODUCT=25
WEIGHT_MANUFACTURER=15
WEIGHT_STRENGTH=10
WEIGHT_FORM=5
WEIGHT_APPEARANCE=5
CANDIDATE_LIMIT=500
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
